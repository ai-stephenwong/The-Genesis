#!/usr/bin/env bash
# =============================================================================
# load-credentials.sh — Doppler credential loader for Autopilot
#
# Only DATABASE_URL is loaded here. All other service credentials are
# handled by MCP servers (GitHub, Vercel, Cloudflare, Neon, Resend, Upstash)
# and do not need to be loaded into the shell environment.
#
# Usage:
#   source .secrets/load-credentials.sh
#   claude
#
# load-credentials.sh is gitignored. This template is safe to commit.
#
# Prerequisites: Doppler CLI installed and authenticated (`doppler login`).
# No API key or DOPPLER_TOKEN is needed — local login session is sufficient.
# DOPPLER_TOKEN is only required for CI/CD (GitHub Actions), not local use.
# =============================================================================
set -euo pipefail

if ! command -v doppler &>/dev/null; then
  echo "[ERROR] Doppler CLI not found. Run: brew install dopplerhq/cli/doppler" >&2
  exit 1
fi

if ! doppler whoami &>/dev/null 2>&1; then
  echo "[ERROR] Not authenticated with Doppler." >&2
  echo "  For Autopilot: set DOPPLER_TOKEN in ~/.zshrc" >&2
  echo "  For manual: run doppler login" >&2
  exit 1
fi

echo "Loading DATABASE_URL from Doppler ({project})..."

export DATABASE_URL=$(doppler secrets get DATABASE_URL --plain --project {project} --config dev)
export DATABASE_URL_STAGING=$(doppler secrets get DATABASE_URL --plain --project {project} --config staging)
export DATABASE_URL_PRODUCTION=$(doppler secrets get DATABASE_URL --plain --project {project} --config production)

echo "Credentials loaded. Start Claude Code now: claude"
